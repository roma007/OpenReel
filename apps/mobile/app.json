{
  "expo": {
    "name": "OpenReel",
    "slug": "openreel",
    "version": "1.0.255",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f0f"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.openreel.ios",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "需要访问本地网络以发现和连接投屏设备",
        "NSCameraUsageDescription": "用于扫描电视上的同步二维码",
        "NSBonjourServices": ["_raop._tcp", "_upnp._tcp", "_airplay._tcp"],
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0f0f"
      },
      "package": "com.openreel.android",
      "permissions": [
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-sqlite",
      "expo-image",
      ["expo-video", { "supportsPictureInPicture": true }],
      "expo-screen-orientation",
      "expo-status-bar",
      "./plugins/withCleartextTraffic",
      ["expo-camera", { "cameraPermission": "用于扫描电视上的同步二维码" }]
    ]
  }
}
